{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "sandboxed-ui",
  "id": "todos",
  "name": "ToDos",
  "version": "0.1.0",
  "description": "Personal to-dos with custom states, tags, priorities, markdown notes, and list and board views.",
  "author": {
    "name": "Uttam Gelot",
    "url": "https://github.com/uttam-gelot"
  },
  "repository": "https://github.com/uttam-gelot/orca-todos",
  "homepage": "https://github.com/uttam-gelot/orca-todos#readme",
  "license": "MIT",
  "icon": "images/icon.png",
  "cover": {
    "path": "images/cover.png",
    "alt": "The ToDos board in dark mode, with one column for each state"
  },
  "screenshots": [
    {
      "path": "images/screenshot-board.png",
      "alt": "The board view in light mode: cards in Backlog, ToDo, In Progress and Done columns",
      "caption": "Board view"
    },
    {
      "path": "images/screenshot-list.png",
      "alt": "The list view in dark mode: to-dos grouped by state, with the details pane open",
      "caption": "List view with details"
    }
  ],
  "engines": {
    "orca": ">=1.4.246"
  },
  "pluginApi": 1,
  "contributes": {
    "panels": [
      {
        "id": "todos",
        "title": "ToDos",
        "icon": "check",
        "entry": "panel.html"
      }
    ],
    "customEditors": [
      {
        "id": "board",
        "title": "ToDos",
        "extensions": [".todos"],
        "entry": "board.html",
        "icon": "images/icon.png",
        "filenames": ["ToDos"]
      }
    ],
    "newFiles": [
      {
        "id": "board",
        "title": "Open ToDos board",
        "extension": ".todos",
        "icon": "images/icon.png"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    }
  ]
}
