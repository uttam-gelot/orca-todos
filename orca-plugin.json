{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "sandboxed-ui",
  "id": "todos",
  "name": "ToDos",
  "version": "0.1.0",
  "description": "Personal to-dos with custom states, tags, priorities, markdown notes, and list and board views.",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "orca": ">=1.4.246"
  },
  "pluginApi": 1,
  "contributes": {
    "panels": [
      {
        "id": "todos",
        "title": "ToDos",
        "icon": "check",
        "entry": "panel.html"
      }
    ],
    "customEditors": [
      {
        "id": "board",
        "title": "ToDos",
        "extensions": [".todos"],
        "entry": "board.html",
        "icon": "images/icon.png",
        "filenames": ["ToDos"]
      }
    ],
    "newFiles": [
      {
        "id": "board",
        "title": "Open ToDos board",
        "extension": ".todos",
        "icon": "images/icon.png"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    }
  ]
}
