{
  "name": "orca-todos",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/main.tsx --outdir dist --entry-naming app.[ext] --target browser --format esm --minify && cp src/fonts/Geist-Variable.woff2 src/fonts/OFL.txt dist/",
    "watch": "bun run build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "pack": "bun run build && rm -rf release && mkdir -p release && cp -R orca-plugin.json panel.html board.html README.md dist images release/",
    "shots": "bun scripts/shots/run.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "dompurify": "^3.4.17",
    "geist": "^1.9.0",
    "lucide-preact": "^1.66.0",
    "marked": "^18.1.2",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.4",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8"
  }
}
